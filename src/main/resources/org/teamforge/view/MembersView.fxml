<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="700.0" prefWidth="940.0" spacing="14.0" styleClass="page" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.teamforge.controller.MembersController">
    <children>
        <VBox>
            <children>
                <Label styleClass="page-title" text="Kelola anggota" />
                <Label fx:id="lblSubjudul" styleClass="muted" text="-" />
            </children>
        </VBox>
        <VBox spacing="8.0" styleClass="card">
            <children>
                <Label styleClass="h3" text="Tambah anggota" />
                <HBox alignment="CENTER_LEFT" spacing="8.0">
                    <children>
                        <TextField fx:id="txtEmail" promptText="Email pengguna terdaftar" HBox.hgrow="ALWAYS" />
                        <ComboBox fx:id="cmbRole" prefWidth="150.0" />
                        <Button mnemonicParsing="false" onAction="#handleTambah" styleClass="primary" text="Tambahkan" />
                    </children>
                </HBox>
                <Label fx:id="lblPesan" managed="false" maxWidth="Infinity" visible="false" wrapText="true" />
            </children>
        </VBox>
        <TableView fx:id="tblAnggota" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colAnggota" prefWidth="260.0" sortable="false" text="Anggota" />
                <TableColumn fx:id="colRole" prefWidth="170.0" sortable="false" text="Role" />
                <TableColumn fx:id="colAktif" prefWidth="100.0" sortable="false" text="Tugas aktif" />
                <TableColumn fx:id="colSelesai" prefWidth="100.0" sortable="false" text="Selesai" />
                <TableColumn fx:id="colAksi" prefWidth="130.0" sortable="false" text="Aksi" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_ALL_COLUMNS" />
            </columnResizePolicy>
        </TableView>
    </children>
</VBox>
