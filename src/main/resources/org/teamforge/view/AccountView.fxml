<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox prefWidth="420.0" spacing="6.0" styleClass="dialog" stylesheets="@../css/teamforge.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.teamforge.controller.AccountController">
    <children>
        <Label styleClass="h2" text="Akun saya" />
        <Label styleClass="field-label" text="Nama" />
        <TextField fx:id="txtNama" />
        <Label styleClass="field-label" text="Email" />
        <TextField fx:id="txtEmail" />
        <Label fx:id="lblPesan" managed="false" styleClass="error-text" visible="false" wrapText="true" />
        <HBox spacing="8.0" styleClass="dialog-footer">
            <children>
                <Button mnemonicParsing="false" onAction="#handleHapus" styleClass="danger" text="Hapus akun" />
                <Region HBox.hgrow="ALWAYS" />
                <Button fx:id="btnBatal" cancelButton="true" mnemonicParsing="false" onAction="#handleBatal" text="Batal" />
                <Button defaultButton="true" mnemonicParsing="false" onAction="#handleSimpan" text="Simpan" />
            </children>
        </HBox>
    </children>
</VBox>
