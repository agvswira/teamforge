<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="700.0" prefWidth="940.0" spacing="14.0" styleClass="page" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.teamforge.controller.TaskListController">
    <fx:define>
        <ToggleGroup fx:id="filterGroup" />
    </fx:define>
    <children>
        <HBox alignment="CENTER_LEFT">
            <children>
                <VBox HBox.hgrow="ALWAYS">
                    <children>
                        <Label fx:id="lblJudul" styleClass="page-title" text="Kelola tugas" />
                        <Label fx:id="lblSubjudul" styleClass="muted" text="-" />
                    </children>
                </VBox>
                <Button fx:id="btnTugasBaru" mnemonicParsing="false" onAction="#handleTugasBaru" styleClass="primary" text="+ Tugas baru" />
            </children>
        </HBox>
        <Label fx:id="lblInfoMember" managed="false" maxWidth="Infinity" styleClass="info-banner" text="Anda MEMBER di project ini. Mulai dan selesaikan tugas Anda lewat menu Tugas saya." visible="false" wrapText="true" />
        <HBox alignment="CENTER_LEFT" spacing="4.0">
            <children>
                <ToggleButton fx:id="tabSemua" mnemonicParsing="false" onAction="#handleFilter" selected="true" styleClass="filter-tab" text="Semua" toggleGroup="$filterGroup" />
                <ToggleButton fx:id="tabTodo" mnemonicParsing="false" onAction="#handleFilter" styleClass="filter-tab" text="To do" toggleGroup="$filterGroup" />
                <ToggleButton fx:id="tabProgress" mnemonicParsing="false" onAction="#handleFilter" styleClass="filter-tab" text="In progress" toggleGroup="$filterGroup" />
                <ToggleButton fx:id="tabDone" mnemonicParsing="false" onAction="#handleFilter" styleClass="filter-tab" text="Done" toggleGroup="$filterGroup" />
                <Region HBox.hgrow="ALWAYS" />
                <TextField fx:id="txtCari" prefWidth="240.0" promptText="Cari judul tugas" />
            </children>
        </HBox>
        <TableView fx:id="tblTugas" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colTugas" prefWidth="320.0" sortable="false" text="Tugas" />
                <TableColumn fx:id="colStatus" prefWidth="110.0" sortable="false" text="Status" />
                <TableColumn fx:id="colPrioritas" prefWidth="90.0" sortable="false" text="Prioritas" />
                <TableColumn fx:id="colTenggat" prefWidth="90.0" sortable="false" text="Tenggat" />
                <TableColumn fx:id="colPenerima" prefWidth="170.0" sortable="false" text="Penerima" />
                <TableColumn fx:id="colAksi" prefWidth="150.0" sortable="false" text="Aksi" />
            </columns>
            <placeholder>
                <Label text="Tidak ada tugas." />
            </placeholder>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_ALL_COLUMNS" />
            </columnResizePolicy>
        </TableView>
    </children>
</VBox>
