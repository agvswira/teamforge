<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="700.0" prefWidth="940.0" spacing="14.0" styleClass="page" stylesheets="@../css/teamforge.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.teamforge.controller.TaskListController">
    <children>
        <HBox alignment="CENTER_LEFT" spacing="10.0">
            <children>
                <VBox HBox.hgrow="ALWAYS">
                    <children>
                        <Label fx:id="lblJudul" styleClass="page-title" text="Kelola tugas" />
                        <Label fx:id="lblSubjudul" styleClass="muted" text="-" />
                    </children>
                </VBox>
                <TextField fx:id="txtCari" prefWidth="240.0" promptText="Cari judul tugas" />
                <Button fx:id="btnTugasBaru" mnemonicParsing="false" onAction="#handleTugasBaru" styleClass="primary" text="+ Tugas baru" />
            </children>
        </HBox>
        <Label fx:id="lblInfoMember" managed="false" maxWidth="Infinity" styleClass="info-banner" text="Anda MEMBER di project ini. Mulai dan selesaikan tugas Anda lewat menu Tugas saya." visible="false" wrapText="true" />
        <!-- Kanban board: satu kolom untuk setiap status tugas -->
        <HBox spacing="20.0" VBox.vgrow="ALWAYS">
            <children>
                <VBox maxWidth="Infinity" prefWidth="100.0" spacing="10.0" HBox.hgrow="ALWAYS">
                    <children>
                        <HBox alignment="CENTER_LEFT" spacing="8.0" styleClass="kanban-header, kanban-header-todo">
                            <children>
                                <Region styleClass="kanban-dot, kanban-dot-todo" />
                                <Label styleClass="strong" text="To do" />
                                <Region HBox.hgrow="ALWAYS" />
                                <Label fx:id="lblJumlahTodo" styleClass="kanban-count" text="0" />
                            </children>
                        </HBox>
                        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="page-scroll" VBox.vgrow="ALWAYS">
                            <content>
                                <VBox fx:id="kolomTodo" spacing="8.0" styleClass="kanban-list" />
                            </content>
                        </ScrollPane>
                    </children>
                </VBox>
                <VBox maxWidth="Infinity" prefWidth="100.0" spacing="10.0" HBox.hgrow="ALWAYS">
                    <children>
                        <HBox alignment="CENTER_LEFT" spacing="8.0" styleClass="kanban-header, kanban-header-progress">
                            <children>
                                <Region styleClass="kanban-dot, kanban-dot-progress" />
                                <Label styleClass="strong" text="In progress" />
                                <Region HBox.hgrow="ALWAYS" />
                                <Label fx:id="lblJumlahProgress" styleClass="kanban-count" text="0" />
                            </children>
                        </HBox>
                        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="page-scroll" VBox.vgrow="ALWAYS">
                            <content>
                                <VBox fx:id="kolomProgress" spacing="8.0" styleClass="kanban-list" />
                            </content>
                        </ScrollPane>
                    </children>
                </VBox>
                <VBox maxWidth="Infinity" prefWidth="100.0" spacing="10.0" HBox.hgrow="ALWAYS">
                    <children>
                        <HBox alignment="CENTER_LEFT" spacing="8.0" styleClass="kanban-header, kanban-header-done">
                            <children>
                                <Region styleClass="kanban-dot, kanban-dot-done" />
                                <Label styleClass="strong" text="Done" />
                                <Region HBox.hgrow="ALWAYS" />
                                <Label fx:id="lblJumlahDone" styleClass="kanban-count" text="0" />
                            </children>
                        </HBox>
                        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="page-scroll" VBox.vgrow="ALWAYS">
                            <content>
                                <VBox fx:id="kolomDone" spacing="8.0" styleClass="kanban-list" />
                            </content>
                        </ScrollPane>
                    </children>
                </VBox>
            </children>
        </HBox>
    </children>
</VBox>
