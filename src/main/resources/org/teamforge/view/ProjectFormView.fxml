<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox prefWidth="480.0" spacing="6.0" styleClass="dialog" stylesheets="@../css/teamforge.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.teamforge.controller.ProjectFormController">
    <children>
        <Label fx:id="lblJudul" styleClass="h2" text="Buat project" />
        <Label styleClass="field-label" text="Nama project" />
        <TextField fx:id="txtNama" />
        <Label styleClass="field-label" text="Deskripsi" />
        <TextArea fx:id="txtDeskripsi" prefRowCount="3" wrapText="true" />
        <Label styleClass="field-label" text="Tenggat" />
        <DatePicker fx:id="dpDeadline" maxWidth="Infinity" />
        <Label fx:id="lblPesan" managed="false" styleClass="error-text" visible="false" wrapText="true" />
        <HBox spacing="8.0" styleClass="dialog-footer">
            <children>
                <Button fx:id="btnHapus" managed="false" mnemonicParsing="false" onAction="#handleHapus" styleClass="danger" text="Hapus project" visible="false" />
                <Region HBox.hgrow="ALWAYS" />
                <Button cancelButton="true" mnemonicParsing="false" onAction="#handleBatal" text="Batal" />
                <Button fx:id="btnSimpan" defaultButton="true" mnemonicParsing="false" onAction="#handleSimpan" text="Simpan" />
            </children>
        </HBox>
    </children>
</VBox>
