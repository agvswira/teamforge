<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="760.0" prefWidth="1180.0" styleClass="app-root" stylesheets="@../css/teamforge.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.teamforge.controller.MainController">
    <fx:define>
        <ToggleGroup fx:id="menuGroup" />
    </fx:define>
    <left>
        <VBox prefWidth="230.0" spacing="4.0" styleClass="sidebar">
            <children>
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <children>
                        <ImageView fitHeight="24.0" pickOnBounds="true" preserveRatio="true">
                            <image>
                                <Image url="@../img/logo.png" />
                            </image>
                        </ImageView>
                        <Label styleClass="strong" text="TeamForge" />
                    </children>
                    <VBox.margin>
                        <Insets bottom="12.0" />
                    </VBox.margin>
                </HBox>
                <Label styleClass="sidebar-section" text="Project aktif" />
                <VBox spacing="4.0" styleClass="project-box">
                    <children>
                        <Label fx:id="lblProjectAktif" styleClass="strong" text="-" wrapText="true" />
                        <Label fx:id="lblRole" styleClass="chip, chip-brand" text="-" />
                    </children>
                </VBox>
                <Label styleClass="sidebar-section" text="Menu" />
                <ToggleButton fx:id="navDashboard" maxWidth="Infinity" mnemonicParsing="false" onAction="#handleMenu" styleClass="nav-item" text="Dashboard" toggleGroup="$menuGroup" />
                <ToggleButton fx:id="navTugas" maxWidth="Infinity" mnemonicParsing="false" onAction="#handleMenu" styleClass="nav-item" text="Kelola tugas" toggleGroup="$menuGroup" />
                <ToggleButton fx:id="navAnggota" maxWidth="Infinity" mnemonicParsing="false" onAction="#handleMenu" styleClass="nav-item" text="Kelola anggota" toggleGroup="$menuGroup" />
                <ToggleButton fx:id="navTugasSaya" maxWidth="Infinity" mnemonicParsing="false" onAction="#handleMenu" styleClass="nav-item" text="Tugas saya" toggleGroup="$menuGroup" />
                <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#handleDaftarProject" styleClass="nav-item" text="Daftar project" />
                <Region VBox.vgrow="ALWAYS" />
                <Label fx:id="lblNama" styleClass="strong" text="-" />
                <Label fx:id="lblEmail" styleClass="caption" text="-" />
                <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#handleKeluar" text="Keluar">
                    <VBox.margin>
                        <Insets top="6.0" />
                    </VBox.margin>
                </Button>
            </children>
        </VBox>
    </left>
    <center>
        <VBox styleClass="main-panel">
            <children>
                <HBox alignment="CENTER_LEFT" spacing="8.0" styleClass="topbar">
                    <children>
                        <Label styleClass="muted" text="Project  ›" />
                        <Label fx:id="lblBreadcrumb" styleClass="strong" text="-" />
                    </children>
                </HBox>
                <StackPane fx:id="paneKonten" VBox.vgrow="ALWAYS" />
            </children>
        </VBox>
    </center>
    <padding>
        <Insets bottom="8.0" right="8.0" top="8.0" />
    </padding>
</BorderPane>
