<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="700.0" prefWidth="940.0" spacing="14.0" styleClass="page" stylesheets="@../css/teamforge.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.teamforge.controller.MyTasksController">
    <children>
        <Label styleClass="page-title" text="Tugas saya" />
        <HBox spacing="16.0" VBox.vgrow="ALWAYS">
            <children>
                <ScrollPane fitToWidth="true" minWidth="260.0" prefWidth="280.0" styleClass="page-scroll">
                    <content>
                        <VBox fx:id="listTugas" spacing="8.0">
                            <padding>
                                <Insets right="6.0" />
                            </padding>
                        </VBox>
                    </content>
                </ScrollPane>
                <StackPane HBox.hgrow="ALWAYS">
                    <children>
                        <Label fx:id="lblKosong" styleClass="muted" text="Belum ada tugas yang ditugaskan kepada Anda." />
                        <ScrollPane fx:id="panelDetail" fitToWidth="true" styleClass="page-scroll">
                            <content>
                                <VBox spacing="10.0" styleClass="card">
                                    <children>
                                        <HBox fx:id="boxChips" spacing="8.0" />
                                        <Label fx:id="lblJudulTugas" styleClass="h2" text="-" wrapText="true" />
                                        <Label fx:id="lblDeskripsi" wrapText="true" />
                                        <GridPane hgap="12.0" vgap="6.0">
                                            <columnConstraints>
                                                <ColumnConstraints minWidth="90.0" />
                                                <ColumnConstraints hgrow="ALWAYS" />
                                            </columnConstraints>
                                            <children>
                                                <Label styleClass="muted" text="Tenggat" />
                                                <Label fx:id="lblTenggat" text="-" GridPane.columnIndex="1" />
                                                <Label styleClass="muted" text="Prioritas" GridPane.rowIndex="1" />
                                                <Label fx:id="lblPrioritas" text="-" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                                                <Label styleClass="muted" text="Penerima" GridPane.rowIndex="2" />
                                                <Label fx:id="lblPenerima" text="-" wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                                            </children>
                                        </GridPane>
                                        <Label styleClass="section-label" text="Prasyarat" />
                                        <VBox fx:id="listPrasyarat" spacing="6.0" />
                                        <Label styleClass="section-label" text="Catatan tugas dan hasil" />
                                        <TextArea fx:id="txtCatatan" prefRowCount="3" wrapText="true" />
                                        <HBox spacing="8.0">
                                            <children>
                                                <Region HBox.hgrow="ALWAYS" />
                                                <Button mnemonicParsing="false" onAction="#handleSimpanCatatan" text="Simpan catatan" />
                                                <Button fx:id="btnAksi" mnemonicParsing="false" onAction="#handleAksi" styleClass="primary" text="Mulai" />
                                            </children>
                                        </HBox>
                                    </children>
                                </VBox>
                            </content>
                        </ScrollPane>
                    </children>
                </StackPane>
            </children>
        </HBox>
    </children>
</VBox>
